(function(){
const year = document.getElementById('year'); if(year) year.textContent = new Date().getFullYear();
// Basit router: iframe src'yi değiştir
const frame = document.getElementById('pageFrame');
document.querySelectorAll('[data-page]').forEach(a=>{
a.addEventListener('click',e=>{ e.preventDefault(); frame.src = a.getAttribute('data-page');
document.getElementById('menuToggle')?.setAttribute('aria-expanded','false');
document.querySelector('.menu')?.classList.remove('open');
});
});
// Mobil menü
const toggle = document.getElementById('menuToggle');
toggle?.addEventListener('click',()=>{
const m = document.querySelector('.menu');
const open = m.classList.toggle('open');
toggle.setAttribute('aria-expanded', open? 'true':'false');
m.style.display = open ? 'flex' : '';
});
// WhatsApp: masaüstü web.whatsapp, mobil api.whatsapp
function isMobile(){return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)}
async function getCompany(){
const res = await fetch('assets/data/company.json');
return res.json();
}
document.getElementById('waBtn')?.addEventListener('click', async ()=>{
const c = await getCompany();
const base = isMobile()? 'https://api.whatsapp.com/send' : 'https://web.whatsapp.com/send';
const url = `${base}?phone=${encodeURIComponent(c.phone)}&text=${encodeURIComponent('Merhaba, bilgi ve teklif almak istiyorum.')}`;
window.open(url, '_blank','noopener');
});
})();