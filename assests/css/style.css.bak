:root{
--bg:#ffffff; --fg:#0b0b0b; --muted:#5f646d; --line:#e6e7ea;
--brand:#111111; --brand-contrast:#ffffff;
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,Arial,sans-serif;background:var(--bg);color:var(--fg)}
.container{max-width:1100px;margin:0 auto;padding:0 16px}
.site-header{position:sticky;top:0;background:#fffcc;backdrop-filter:saturate(1.2) blur(8px);background:rgba(255,255,255,.85);border-bottom:1px solid var(--line);z-index:50}
.nav{display:flex;align-items:center;justify-content:space-between;height:64px}
.brand{display:flex;align-items:center;gap:12px;color:inherit;text-decoration:none}
.logo{width:40px;height:40px;object-fit:contain}
.brand-text{display:flex;flex-direction:column;line-height:1}
.brand-text strong{letter-spacing:1px}
.menu{display:flex;gap:12px}
.menu a{padding:8px 12px;border-radius:10px;color:inherit;text-decoration:none}
.menu a:hover{background:var(--line)}
.burger{display:none;border:1px solid var(--line);background:#fff;border-radius:10px;padding:8px}
.burger span{display:block;width:22px;height:2px;background:var(--fg);margin:4px 0}


main iframe#pageFrame{width:100%;height:calc(100dvh - 64px - 64px);border:0;border-radius:16px;overflow:hidden;background:#fff}
.site-footer{border-top:1px solid var(--line);padding:18px 0;color:var(--muted);font-size:14px}


.hero{padding:24px}
.grid{display:grid;grid-template-columns:1.1fr 1fr;gap:16px;padding:24px}
.list{padding-left:0;list-style:none}
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--brand);color:var(--brand-contrast);padding:10px 14px;border-radius:12px;text-decoration:none}
.btn:hover{opacity:.9}
.muted{color:var(--muted)}
.map{width:100%;height:360px;border:1px solid var(--line);border-radius:16px}


.whatsapp{position:fixed;right:16px;bottom:16px;background:#25d366;color:#fff;width:56px;height:56px;display:grid;place-items:center;border-radius:50%;box-shadow:0 10px 30px rgba(0,0,0,.35);border:none;cursor:pointer;z-index:60}
.whatsapp svg{width:28px;height:28px;fill:currentColor}


@media (max-width:900px){
.menu{display:none}
.burger{display:block}
.grid{grid-template-columns:1fr}
main iframe#pageFrame{height:calc(100dvh - 56px - 64px)}
.nav{height:56px}
}